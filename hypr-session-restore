#!/usr/bin/env python3
"""hypr-session-restore — macOS-style "reopen windows on login" for Hyprland 0.55+.

save    - snapshot all mapped windows (workspace, geometry, relaunch command)
restore - relaunch every saved window silently on its original workspace
daemon  - run `save` every SAVE_INTERVAL seconds as a safety net for
          shutdowns that bypass your power menu (power button, crashes)

State lives in $XDG_STATE_HOME/hypr-session-restore (override: $HYPR_SESSION_DIR).
Disable restore entirely:  touch <state dir>/disabled
Extra excluded classes:    HYPR_SESSION_EXCLUDE="class1,class2"
Class-to-command mappings: ~/.config/hypr-session-restore/class-cmd.conf
  One mapping per line: pattern = command-template
  Example (Chrome PWAs):
    chrome-(?P<domain>[^_]+)__-Profile_\\d+ = chromium --app=https://{domain}/

Requires Hyprland >= 0.55 (Lua-era dispatcher syntax).
"""

import json
import os
import re
import shlex
import subprocess
import sys
import time

STATE_DIR = os.environ.get("HYPR_SESSION_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "hypr-session-restore",
)
SESSION_FILE = os.path.join(STATE_DIR, "session.json")
DISABLE_FLAG = os.path.join(STATE_DIR, "disabled")

CONFIG_DIR = os.environ.get("HYPR_SESSION_CONFIG_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "hypr-session-restore",
)
CLASS_CMD_FILE = os.path.join(CONFIG_DIR, "class-cmd.conf")
# Legacy location, kept for backward compatibility.
CLASS_CMD_FILE_LEGACY = os.path.join(STATE_DIR, "class-cmd.conf")

# Windows of these classes are never saved/restored. Add anything your
# autostart already launches (bars, tray bridges, scratchpad daemons, ...)
# here or via HYPR_SESSION_EXCLUDE="class1,class2".
EXCLUDE_CLASSES = {
    "org.quickshell",
    "xembedsniproxy",
}
EXCLUDE_CLASSES |= {
    c.strip() for c in os.environ.get("HYPR_SESSION_EXCLUDE", "").split(",") if c.strip()
}

# Terminal handling: if a known TUI runs inside, relaunch it in its cwd;
# otherwise reopen the terminal in the shell's cwd.
# class -> (binary, cwd flag, exec flag or None)
TERMINALS = {
    "kitty": ("kitty", "-d", None),
    "foot": ("foot", "-D", None),
    "Alacritty": ("alacritty", "--working-directory", "-e"),
}
TUI_PROGRAMS = {"yazi", "nvim", "vim", "btop", "htop", "ranger", "lf"}
SHELLS = {"fish", "zsh", "bash", "sh", "nu"}

# Apps where every window belongs to a single process, but each invocation of
# the command creates a new window in the same instance. For these classes we
# relaunch once per saved window. Other single-instance apps are handled via
# class-cmd.conf (spawn once per class).
SPAWN_ALL_CLASSES = {
    "com.mitchellh.ghostty",
}

SAVE_INTERVAL = 60
DAEMON_INITIAL_DELAY = 90
SWEEP_TIMEOUT = 20
SPAWN_STAGGER = 0.3


def hyprctl_json(cmd):
    out = subprocess.run(["hyprctl", "-j", cmd], capture_output=True, text=True, timeout=10)
    return json.loads(out.stdout)


def dispatch(lua):
    subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True, timeout=10)


# ---------------------------------------------------------------- /proc utils

def proc_cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            parts = f.read().split(b"\0")
        return [p.decode("utf-8", "replace") for p in parts if p]
    except OSError:
        return None


def proc_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return None


def proc_comm(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip()
    except OSError:
        return None


def proc_children(pid):
    pids = []
    try:
        for task in os.listdir(f"/proc/{pid}/task"):
            try:
                with open(f"/proc/{pid}/task/{task}/children") as f:
                    pids += [int(p) for p in f.read().split()]
            except OSError:
                pass
    except OSError:
        pass
    return pids


def find_descendant(pid, names, max_depth=5):
    """BFS the process tree under pid for a comm in `names`."""
    queue = [(c, 1) for c in proc_children(pid)]
    while queue:
        cur, depth = queue.pop(0)
        if proc_comm(cur) in names:
            return cur
        if depth < max_depth:
            queue += [(c, depth + 1) for c in proc_children(cur)]
    return None


# ----------------------------------------------------------------------- save

def load_class_cmd_patterns():
    """Load user-defined class-to-command mappings from class-cmd.conf."""
    patterns = []
    path = CLASS_CMD_FILE
    if not os.path.exists(path) and os.path.exists(CLASS_CMD_FILE_LEGACY):
        path = CLASS_CMD_FILE_LEGACY
    if not os.path.exists(path):
        return patterns
    with open(path, "r", encoding="utf-8") as f:
        for line_no, line in enumerate(f, start=1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                print(
                    f"hypr-session-restore: {CLASS_CMD_FILE}:{line_no}: missing '='",
                    file=sys.stderr,
                )
                continue
            pattern_str, template = line.split("=", 1)
            pattern_str = pattern_str.strip()
            template = template.strip()
            if not pattern_str or not template:
                continue
            try:
                patterns.append((re.compile(pattern_str), template))
            except re.error as e:
                print(
                    f"hypr-session-restore: {CLASS_CMD_FILE}:{line_no}: invalid regex: {e}",
                    file=sys.stderr,
                )
    return patterns


def class_relaunch_command(cls, patterns, cwd):
    """Return a command derived from the window class if a mapping matches."""
    for pattern, template in patterns:
        m = pattern.search(cls)
        if m:
            try:
                return template.format(cwd=cwd, **m.groupdict())
            except (KeyError, IndexError) as e:
                print(
                    f"hypr-session-restore: class-cmd template error for {cls!r}: {e}",
                    file=sys.stderr,
                )
                return None
    return None


def relaunch_command(client, patterns=None):
    """Build the shell command that recreates this window's process."""
    if patterns is None:
        patterns = load_class_cmd_patterns()

    pid = client["pid"]
    cls = client.get("class", "")
    cwd = proc_cwd(pid) or os.path.expanduser("~")

    # User-defined class-to-command mappings take precedence.
    cmd = class_relaunch_command(cls, patterns, cwd)
    if cmd:
        return cmd

    if cls in TERMINALS:
        binary, cwd_flag, exec_flag = TERMINALS[cls]
        tui = find_descendant(pid, TUI_PROGRAMS)
        if tui is not None:
            argv = proc_cmdline(tui) or [proc_comm(tui)]
            # drop session-specific temp-file args (yazi --cwd-file=...)
            argv = [a for a in argv if not a.startswith("--cwd-file")]
            cwd = proc_cwd(tui) or os.path.expanduser("~")
            cmd = [binary, cwd_flag, cwd]
            if exec_flag:
                cmd.append(exec_flag)
            return shlex.join(cmd + argv)
        sh = find_descendant(pid, SHELLS)
        cwd = (proc_cwd(sh) if sh else None) or proc_cwd(pid) or os.path.expanduser("~")
        return shlex.join([binary, cwd_flag, cwd])

    argv = proc_cmdline(pid)
    if not argv:
        return None
    return shlex.join(argv)


def save():
    clients = hyprctl_json("clients")
    patterns = load_class_cmd_patterns()
    windows = []
    spawned_pids = set()
    spawned_self_restore = set()
    for c in clients:
        if not c.get("mapped") or c.get("pid", -1) <= 0:
            continue
        # windows with no class are invisible helpers (e.g. tray bridges)
        if not c.get("class") or c["class"] in EXCLUDE_CLASSES:
            continue
        cmd = relaunch_command(c, patterns)
        if not cmd:
            continue
        cls = c.get("class", "")
        pid = c["pid"]
        has_class_cmd = class_relaunch_command(cls, patterns, proc_cwd(pid) or "") is not None

        # Decide whether to relaunch this window or let the sweep pass place it.
        # SPAWN_ALL_CLASSES (e.g. ghostty) get one spawn per saved window because
        # each invocation creates a new window. Classes with a custom class-cmd
        # mapping spawn once per class; the command is expected to restore or
        # create the remaining windows. Regular apps get one spawn per process.
        if cls in SPAWN_ALL_CLASSES:
            spawn = True
        elif has_class_cmd:
            spawn = cls not in spawned_self_restore
            spawned_self_restore.add(cls)
        else:
            spawn = pid not in spawned_pids
            spawned_pids.add(pid)

        windows.append({
            "class": cls,
            "title": c.get("title", ""),
            "workspace": c["workspace"],
            "at": c["at"],
            "size": c["size"],
            "floating": c.get("floating", False),
            "pinned": c.get("pinned", False),
            "fullscreen": c.get("fullscreen", 0),
            "monitor": c.get("monitor", 0),
            "cmd": cmd,
            "spawn": spawn,
        })

    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = SESSION_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"saved_at": time.time(), "windows": windows}, f, indent=2)
    os.replace(tmp, SESSION_FILE)
    return len(windows)


# -------------------------------------------------------------------- restore

def ws_selector(ws):
    """workspace dict from hyprctl -> workspace selector string."""
    name = ws.get("name", "")
    wid = ws.get("id", 0)
    if name.startswith("special"):
        return name
    if name == str(wid):
        return str(wid)
    return f"name:{name}"


def lua_str(s):
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


def lua_long_str(s):
    # long-bracket literal; bump the level if the payload contains the closer
    eq = ""
    while f"]{eq}]" in s:
        eq += "="
    return f"[{eq}[{s}]{eq}]"


def exec_rules(win):
    rules = [f"workspace = {lua_str(ws_selector(win['workspace']) + ' silent')}"]
    if win["floating"]:
        rules.append("float = true")
        rules.append(f"move = {{{win['at'][0]}, {win['at'][1]}}}")
        rules.append(f"size = {{{win['size'][0]}, {win['size'][1]}}}")
    if win["pinned"]:
        rules.append("pin = true")
    return "{ " + ", ".join(rules) + " }"


def fix_window(win, address):
    """Silently move/shape an existing window to match its saved state."""
    target = lua_str(f"address:{address}")
    ws = ws_selector(win["workspace"])
    dispatch(f"hl.dsp.window.move({{ workspace = {lua_str(ws)}, follow = false, window = {target} }})")
    if win["floating"]:
        dispatch(f"hl.dsp.window.float({{ action = 'on', window = {target} }})")
        dispatch(f"hl.dsp.window.move({{ x = {win['at'][0]}, y = {win['at'][1]}, window = {target} }})")
        dispatch(f"hl.dsp.window.resize({{ x = {win['size'][0]}, y = {win['size'][1]}, window = {target} }})")
    if win["pinned"]:
        dispatch(f"hl.dsp.window.pin({{ action = 'on', window = {target} }})")
    fs = win.get("fullscreen", 0)
    if fs:
        mode = "fullscreen" if fs & 2 else "maximized"
        dispatch(f"hl.dsp.window.fullscreen({{ mode = '{mode}', action = 'set', window = {target} }})")


def current_clients():
    return {
        c["address"]: c
        for c in hyprctl_json("clients")
        if c.get("mapped") and c.get("class") and c["class"] not in EXCLUDE_CLASSES
    }


def restore():
    if os.path.exists(DISABLE_FLAG):
        return
    try:
        with open(SESSION_FILE) as f:
            session = json.load(f)
    except (OSError, ValueError):
        return
    windows = session.get("windows", [])
    if not windows:
        return

    initial = current_clients()
    if len(initial) > 3:
        print("hypr-session-restore: session already populated, aborting", file=sys.stderr)
        return

    # tiled windows first (left-to-right, top-to-bottom approximates the old
    # tiling), floating after so they stack above
    order = sorted(
        range(len(windows)),
        key=lambda i: (
            windows[i]["workspace"].get("id", 0),
            windows[i]["floating"],
            windows[i]["at"][0],
            windows[i]["at"][1],
        ),
    )

    for i in order:
        win = windows[i]
        if not win["spawn"]:
            continue
        dispatch(f"hl.dsp.exec_cmd({lua_long_str(win['cmd'])}, {exec_rules(win)})")
        time.sleep(SPAWN_STAGGER)

    # Sweep: exec_cmd rules track the spawned PID, so windows from forking /
    # single-instance apps (and second windows of one process) come up
    # unplaced. Match them by class and move them silently.
    pending = [windows[i] for i in order]
    deadline = time.time() + SWEEP_TIMEOUT
    seen = set(initial)
    while pending and time.time() < deadline:
        time.sleep(1)
        for addr, client in current_clients().items():
            if addr in seen:
                continue
            match = None
            for win in pending:
                if win["class"] != client.get("class", ""):
                    continue
                match = win
                if client["workspace"].get("id") == win["workspace"].get("id"):
                    break  # already in place: prefer this pairing
            if match is None:
                continue
            pending.remove(match)
            seen.add(addr)
            misplaced = client["workspace"].get("id") != match["workspace"].get("id")
            geometry_off = match["floating"] and (
                client.get("floating") != match["floating"] or client["at"] != match["at"]
            )
            if misplaced or geometry_off or match.get("fullscreen", 0) or match["pinned"]:
                fix_window(match, addr)


def daemon():
    time.sleep(DAEMON_INITIAL_DELAY)
    while True:
        try:
            save()
        except Exception as e:
            print(f"hypr-session-restore: save failed: {e}", file=sys.stderr)
        time.sleep(SAVE_INTERVAL)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "save":
        n = save()
        print(f"saved {n} windows to {SESSION_FILE}")
    elif action == "restore":
        restore()
    elif action == "daemon":
        daemon()
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
